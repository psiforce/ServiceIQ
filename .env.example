# Copy this file to .env and fill in your values. Never commit .env.

# --- OpenAI (required for Sprint 1: embeddings + answer generation) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (required for Sprint 1: vector search) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=serviceiq-dev

# --- LangSmith (Sprint 2: tracing + evaluation; optional before then) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=serviceiq-dev

# --- Email notifications for escalations (Sprint 3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ESCALATION_FROM_EMAIL=

# --- Evaluation clock (keeps synthetic-data effective/expiry dates stable) ---
SERVICEIQ_AS_OF_DATE=2026-10-26

# --- Phase 2-3 agent and field-service platform (M14+) ---
AGENT_ENABLED=true
# Field-service platform URL; leave empty to run it in-process on FSP_DATABASE_URL (local dev)
FSP_URL=
FSP_DATABASE_URL=sqlite:///var/fieldservice.db
# JSON {"tenant": "key"}; locally `python -m fieldservice seed` writes keys to var/dev_fsp_keys.json
FSP_API_KEYS=
# Phase 3: offer times and book jobs within the approval policy (false = the office books)
AGENT_BOOKING_ENABLED=true
# JSON {"tenant": ["tool", ...]} to limit the agent's tools per company; empty = all tools
AGENT_TOOL_ALLOWLIST=
AGENT_BOOKINGS_PER_MINUTE=30

# --- Phase 4: invoice, payment and review after the job (M19+) ---
# false = the completion is recorded and a ticket asks the office to bill by hand
AGENT_PAYMENTS_ENABLED=true
# Stripe hosted Checkout (use test keys first). Empty = an in-memory payment page for local dev and evaluation;
# the webhook endpoint then accepts nothing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Shared HMAC key for job.completed events from the field-service platform (/v1/events/fieldservice).
# The platform signs with the same value as SERVICEIQ_WEBHOOK_SECRET, and posts to SERVICEIQ_WEBHOOK_URL.
FSP_WEBHOOK_SECRET=
SERVICEIQ_WEBHOOK_URL=
SERVICEIQ_WEBHOOK_SECRET=
PAYMENT_REMINDER_DAYS=3
REVIEW_REMINDER_DAYS=7
# Customer chat address: payment-return and review links in emails point here
PUBLIC_BASE_URL=http://localhost:8501
