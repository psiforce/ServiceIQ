# Copy this file to .env and fill in your values. Never commit .env.

# --- OpenAI (required for Sprint 1: embeddings + answer generation) ---
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Pinecone (required for Sprint 1: vector search) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=serviceiq-dev

# --- LangSmith (Sprint 2: tracing + evaluation; optional before then) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=serviceiq-dev

# --- Email notifications for escalations (Sprint 3) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ESCALATION_FROM_EMAIL=

# --- Evaluation clock (keeps synthetic-data effective/expiry dates stable) ---
SERVICEIQ_AS_OF_DATE=2026-10-26

# --- Phase 2-3 agent and field-service platform (M14+) ---
AGENT_ENABLED=true
# Field-service platform URL; leave empty to run it in-process on FSP_DATABASE_URL (local dev)
FSP_URL=
FSP_DATABASE_URL=sqlite:///var/fieldservice.db
# JSON {"tenant": "key"}; locally `python -m fieldservice seed` writes keys to var/dev_fsp_keys.json
FSP_API_KEYS=
# Phase 3: offer times and book jobs within the approval policy (false = the office books)
AGENT_BOOKING_ENABLED=true
# JSON {"tenant": ["tool", ...]} to limit the agent's tools per company; empty = all tools
AGENT_TOOL_ALLOWLIST=
AGENT_BOOKINGS_PER_MINUTE=30
